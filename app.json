{
  "expo": {
    "name": "ZankoBook",
    "slug": "ZankoBook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/outsideLogo/teal.png",
    "scheme": "zankobook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/outsideLogo/teal.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.rivaniraqsteam.ZankoBook",
      "icon": "./assets/outsideLogo/teal.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/transparent.png",
          "imageWidth": 1,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "light"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66f96615-d034-47c9-b64f-df61f0a9f41a"
      }
    },
    "owner": "rivaniraqs-team"
  }
}
